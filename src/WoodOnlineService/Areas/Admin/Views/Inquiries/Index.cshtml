@model WoodOnlineService.Areas.Admin.ViewModels.AdminListViewModel<WoodOnlineService.Models.Inquiry>
@{
    ViewData["Title"] = "Inquiries";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-1">Inquiries</h1>
        <p class="text-muted-wood mb-0">Customer questions and custom order requests</p>
    </div>
</div>

<div class="panel mb-3">
    <div class="panel-body py-3">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-action="Index" asp-route-search="@Model.Search"
               class="btn btn-sm @(string.IsNullOrEmpty(Model.Status) ? "btn-wood" : "btn-outline-wood")">
                All (@Model.TotalCount)
            </a>
            <a asp-action="Index" asp-route-status="New" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.Status == "New" ? "btn-wood" : "btn-outline-wood")">
                New (@ViewBag.NewCount)
            </a>
            <a asp-action="Index" asp-route-status="Contacted" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.Status == "Contacted" ? "btn-wood" : "btn-outline-wood")">
                Contacted (@ViewBag.ContactedCount)
            </a>
            <a asp-action="Index" asp-route-status="Closed" asp-route-search="@Model.Search"
               class="btn btn-sm @(Model.Status == "Closed" ? "btn-wood" : "btn-outline-wood")">
                Closed (@ViewBag.ClosedCount)
            </a>
        </div>

        <form method="get" asp-action="Index" class="row g-2">
            <input type="hidden" name="status" value="@Model.Status" />
            <div class="col-md-9">
                <input type="search" name="search" value="@Model.Search" class="form-control"
                       placeholder="Search by name, phone or message..." />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-wood flex-grow-1">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-action="Index" asp-route-status="@Model.Status" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="panel">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <div style="font-size:3rem;">💬</div>
            <h3>No inquiries found</h3>
            <p>Whenever a customer submits the contact form it will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-wood mb-0">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Message</th>
                        <th>Date</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr class="@(i.Status == InquiryStatus.New ? "table-warning" : "")">
                            <td>
                                <div class="fw-bold small">@i.Name</div>
                                <div class="small">
                                    <a href="tel:@i.Phone">@i.Phone</a>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(i.Email))
                                {
                                    <div class="small text-muted-wood text-truncate" style="max-width:170px;">@i.Email</div>
                                }
                            </td>
                            <td class="small">
                                @if (i.Product is not null)
                                {
                                    <span class="badge badge-soft">@i.Product.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted-wood">General</span>
                                }
                            </td>
                            <td class="small" style="max-width:280px;">
                                <div class="text-truncate">@i.Message</div>
                            </td>
                            <td class="small text-nowrap">@i.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")<br />
                                <span class="text-muted-wood">@i.CreatedDate.ToLocalTime().ToString("hh:mm tt")</span>
                            </td>
                            <td class="text-center">
                                @if (i.Status == InquiryStatus.New)
                                {
                                    <span class="badge bg-danger">New</span>
                                }
                                else if (i.Status == InquiryStatus.Contacted)
                                {
                                    <span class="badge bg-info text-dark">Contacted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a href="https://wa.me/@(new string(i.Phone.Where(char.IsDigit).ToArray()))"
                                       target="_blank" rel="noopener" class="btn btn-sm btn-whatsapp" title="WhatsApp">💬</a>
                                    <a asp-action="Details" asp-route-id="@i.InquiryId" class="btn btn-sm btn-outline-wood">View</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="panel-body">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                   asp-route-status="@Model.Status" asp-route-search="@Model.Search">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>
