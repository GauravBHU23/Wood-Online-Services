@model WoodOnlineService.Services.InvoiceModel
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @Model.InvoiceNumber</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/invoice.css" asp-append-version="true" />
    <style>
        body { background: #f4efe6; padding: 20px 12px; }
        @@media print { body { padding: 0; background: #fff; } }
    </style>
</head>
<body>
    <div class="no-print" style="max-width:820px;margin:0 auto 14px;display:flex;gap:8px;justify-content:flex-end;">
        <button onclick="window.print()" class="btn btn-wood">Print / Save as PDF</button>
        <a asp-action="Details" asp-route-id="@Model.Order.OrderId" class="btn btn-outline-wood">Back to Order</a>
    </div>

    <partial name="_Invoice" model="Model" />
</body>
</html>
