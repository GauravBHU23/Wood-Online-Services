@model WoodOnlineService.Models.ApplicationUser
@{
    ViewData["Title"] = Model.FullName;
    var orders = (List<WoodOnlineService.Models.Order>)ViewBag.Orders;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var isBlocked = (bool)ViewBag.IsBlocked;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var totalSpend = orders.Where(o => o.OrderStatus != WoodOnlineService.Models.OrderStatus.Cancelled).Sum(o => o.TotalAmount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-1">@Model.FullName</h1>
        <p class="text-muted-wood mb-0">
            Customer since @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-wood">&larr; All Customers</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="panel mb-3">
            <div class="panel-header">Account</div>
            <div class="panel-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Email</dt>
                    <dd class="col-7"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-5">Phone</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                        }
                        else
                        {
                            <span class="text-muted-wood">—</span>
                        }
                    </dd>

                    <dt class="col-5">Address</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <text>@Model.Address</text>
                            <br />
                            <text>@Model.City, @Model.State @Model.PinCode</text>
                        }
                        else
                        {
                            <span class="text-muted-wood">Not provided</span>
                        }
                    </dd>

                    <dt class="col-5">Status</dt>
                    <dd class="col-7">
                        @if (isAdmin)
                        {
                            <span class="badge bg-secondary">Admin account</span>
                        }
                        else if (isBlocked)
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (!isAdmin)
        {
            <div class="panel">
                <div class="panel-body">
                    @if (isBlocked)
                    {
                        <form asp-action="Unblock" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-wood w-100" data-busy-text="Unblocking...">
                                Unblock this customer
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Block" asp-route-id="@Model.Id" method="post"
                              data-confirm="This customer will not be able to sign in until you unblock them. Continue?"
                              data-confirm-title="Block customer">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-outline-danger w-100" data-busy-text="Blocking...">
                                Block this customer
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <span>Orders (@orders.Count)</span>
                <span class="fw-bold">Total spend: ₹@totalSpend.ToString("N0")</span>
            </div>

            @if (orders.Count == 0)
            {
                <div class="empty-state">
                    <div style="font-size:3rem;">📦</div>
                    <h3>No orders yet</h3>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-wood mb-0">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Payment</th>
                                <th class="text-center">Status</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orders)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold small">@o.OrderNumber</div>
                                        <div class="small text-muted-wood">@o.OrderDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                                    </td>
                                    <td class="text-end fw-bold">₹@o.TotalAmount.ToString("N0")</td>
                                    <td class="text-center small">
                                        <span class="badge @(o.PaymentStatus == WoodOnlineService.Models.PaymentStatus.Paid ? "bg-success" : "bg-secondary")">
                                            @o.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <partial name="_OrderStatusBadge" model="o.OrderStatus" />
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId"
                                           class="btn btn-sm btn-outline-wood">View</a>
                                        <a asp-controller="Orders" asp-action="Invoice" asp-route-id="@o.OrderId"
                                           target="_blank" class="btn btn-sm btn-outline-wood">🧾</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
