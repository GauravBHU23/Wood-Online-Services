@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6 mx-auto">
            <div class="panel">
                <div class="panel-body text-center py-5">
                    <div style="font-size:3.5rem;" class="mb-3">🔒</div>
                    <h1 class="mb-3">Access Denied</h1>
                    <p class="text-muted-wood mb-4">
                        You do not have permission to view this page.
                        If you believe this is a mistake, please contact us.
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-wood">Go to Home</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-wood">Sign in with another account</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
