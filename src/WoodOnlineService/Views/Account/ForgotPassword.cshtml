@model WoodOnlineService.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-6 col-lg-5 mx-auto">
            <div class="panel">
                <div class="panel-header text-center">Forgot your password?</div>
                <div class="panel-body">
                    <p class="text-muted-wood small mb-4">
                        Enter the email address on your account and we will send you a link to
                        set a new password. The link works once and expires after a short time.
                    </p>

                    <form asp-action="ForgotPassword" method="post" novalidate data-validate-on-submit>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email"
                                   autocomplete="username" placeholder="you@example.com"
                                   data-validate="required|email" data-label="Email address" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <button type="submit" class="btn btn-wood w-100 btn-lg" data-busy-text="Sending...">
                            Send Reset Link
                        </button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0 small">
                        Remembered it? <a asp-action="Login" class="fw-bold">Back to sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
