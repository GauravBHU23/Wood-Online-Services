@model WoodOnlineService.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-8 col-lg-6 mx-auto">
            <div class="panel">
                <div class="panel-header text-center">Create an account</div>
                <div class="panel-body">
                    <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post"
                          novalidate data-validate-on-submit>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="FullName" class="form-control" autocomplete="name"
                                   placeholder="Your full name"
                                   data-validate="required|min:2" data-label="Full name" />
                            <span asp-validation-for="FullName" class="field-validation-error"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-1">
                                <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="username"
                                       placeholder="you@example.com"
                                       data-validate="required|email" data-label="Email address" />
                                <span asp-validation-for="Email" class="field-validation-error"></span>
                            </div>

                            <div class="col-md-6 mb-1">
                                <label asp-for="PhoneNumber" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel"
                                       placeholder="98765 43210"
                                       data-validate="required|phone" data-label="Phone number" />
                                <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6 mb-1">
                                <label asp-for="Password" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="Password" id="Password" class="form-control" type="password"
                                       autocomplete="new-password"
                                       data-validate="required|min:8" data-label="Password" />
                                <span asp-validation-for="Password" class="field-validation-error"></span>
                            </div>

                            <div class="col-md-6 mb-1">
                                <label asp-for="ConfirmPassword" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="ConfirmPassword" class="form-control" type="password"
                                       autocomplete="new-password"
                                       data-validate="required|match:Password" data-label="Confirmation"
                                       data-mismatch="The two passwords do not match." />
                                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                            </div>
                        </div>

                        <p class="small text-muted-wood mt-2 mb-3">
                            Password must be at least 8 characters and include a number, an uppercase and a lowercase letter.
                        </p>

                        <button type="submit" class="btn btn-wood w-100 btn-lg" data-busy-text="Creating your account...">
                            Create Account
                        </button>
                    </form>

                    <hr class="my-4" />

                    <p class="text-center mb-0 small">
                        Already have an account?
                        <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="fw-bold">Sign In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

