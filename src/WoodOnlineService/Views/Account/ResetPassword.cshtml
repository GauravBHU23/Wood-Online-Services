@model WoodOnlineService.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-6 col-lg-5 mx-auto">
            <div class="panel">
                <div class="panel-header text-center">Choose a new password</div>
                <div class="panel-body">
                    <p class="text-muted-wood small mb-4">
                        Setting a new password for <strong>@Model.Email</strong>.
                    </p>

                    <form asp-action="ResetPassword" method="post" novalidate data-validate-on-submit>
                        @Html.AntiForgeryToken()

                        @* The token travels with the form; it is single-use and time limited. *@
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">New Password</label>
                            <input asp-for="Password" id="Password" class="form-control" type="password"
                                   autocomplete="new-password"
                                   data-validate="required|min:8" data-label="New password" />
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password"
                                   autocomplete="new-password"
                                   data-validate="required|match:Password" data-label="Confirmation"
                                   data-mismatch="The two passwords do not match." />
                            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                        </div>

                        <p class="small text-muted-wood mb-3">
                            Password must be at least 8 characters and include a number,
                            an uppercase and a lowercase letter.
                        </p>

                        <button type="submit" class="btn btn-wood w-100 btn-lg" data-busy-text="Updating...">
                            Set New Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
