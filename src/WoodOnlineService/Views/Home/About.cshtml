@using Microsoft.Extensions.Options
@using WoodOnlineService.Models
@inject IOptions<SiteSettings> Site
@{
    var site = Site.Value;
    ViewData["Title"] = "About Us";
}

<div class="bg-wood-50 border-bottom border-wood py-4">
    <div class="container">
        <h1 class="mb-1">About Us</h1>
        <p class="text-muted-wood mb-0">@site.Tagline</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 g-lg-5 align-items-center mb-5">
        <div class="col-lg-6">
            <h2 class="section-title">A Trade Passed Down</h2>
            <p>
                @site.ShopName is a family run workshop. Woodwork is our trade, and we learned it
                from our elders. What we build for you is what we keep in our own homes.
            </p>
            <p>
                Cheap furniture is everywhere today: particle board, plywood, glued-on veneer.
                It lasts two years, then swells or breaks. That is not what we make.
                Every piece we make is <strong>solid wood</strong> throughout, the same timber inside and out.
            </p>
            <p class="mb-0">
                That is why our pieces cost a little more. But buy once,
                and it will serve the next generation.
            </p>
        </div>
        <div class="col-lg-6">
            <img src="~/img/workshop.svg" alt="Our workshop" class="img-fluid rounded" style="border:1px solid var(--line);" />
        </div>
    </div>

    <h2 class="section-title text-center mb-4">How We Work</h2>
    <div class="row g-4 mb-5">
        @{
            var steps = new (string Icon, string Title, string Text)[]
            {
                ("1️⃣", "Choosing the Timber",
                 "Sheesham, Teak, Mango or Pine, chosen for the job. Timber comes straight from the market, with no middleman."),
                ("2️⃣", "Seasoning and Treatment",
                 "The wood is dried until the moisture is gone, then termite treated so pests are no longer a worry."),
                ("3️⃣", "Craftsmanship",
                 "Our craftsmen cut mortise-and-tenon joints by hand. We do not rely on nails and glue."),
                ("4️⃣", "Finishing and Delivery",
                 "The polish of your choice, then delivery and assembly at your home. We stay with you until the job is done.")
            };
        }
        @foreach (var s in steps)
        {
            <div class="col-md-6 col-lg-3">
                <div class="panel h-100">
                    <div class="panel-body text-center">
                        <div style="font-size:2rem;" class="mb-2">@s.Icon</div>
                        <h3 style="font-size:1.05rem;">@s.Title</h3>
                        <p class="small text-muted-wood mb-0">@s.Text</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-header">Our Promise</div>
                <div class="panel-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">✅ <strong>Solid wood only</strong> - no particle board or plywood filling</li>
                        <li class="mb-2">✅ <strong>Seasoned and treated</strong> timber that will not crack or attract termites</li>
                        <li class="mb-2">✅ <strong>Made to your size</strong> without any fuss</li>
                        <li class="mb-2">✅ <strong>Honest pricing</strong> - the quoted price is the final price, no hidden charges</li>
                        <li class="mb-0">✅ <strong>Support after the sale</strong> - tell us if anything is wrong and we will fix it</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel h-100">
                <div class="panel-header">Shop Details</div>
                <div class="panel-body">
                    <table class="table table-sm spec-table mb-0">
                        <tbody>
                            <tr><th>Shop</th><td>@site.ShopName</td></tr>
                            <tr><th>Address</th><td>@site.AddressLine1<br />@site.AddressLine2</td></tr>
                            <tr><th>Phone</th><td><a href="tel:@site.Phone.Replace(" ", "")">@site.Phone</a></td></tr>
                            <tr><th>WhatsApp</th><td><a href="https://wa.me/@site.WhatsAppNumber" target="_blank" rel="noopener">Chat on WhatsApp</a></td></tr>
                            <tr><th>Email</th><td><a href="mailto:@site.Email">@site.Email</a></td></tr>
                            <tr><th>Hours</th><td>@site.WorkingHours</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-body text-center py-5">
            <h2 class="mb-3">Visit Our Shop</h2>
            <p class="text-muted-wood mx-auto mb-4" style="max-width:36rem;">
                A photograph cannot show the real quality of wood. Visit the shop once,
                feel it with your own hands, and then decide.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-wood btn-lg">Contact Us</a>
                <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-wood btn-lg">Browse Products</a>
            </div>
        </div>
    </div>
</div>
