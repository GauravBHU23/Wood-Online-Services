@{
    var code = ViewBag.StatusCode as int?;
    var isNotFound = code == 404;
    ViewData["Title"] = isNotFound ? "Page Not Found" : "Something Went Wrong";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-7 mx-auto">
            <div class="panel">
                <div class="panel-body text-center py-5">
                    <div style="font-size:3.5rem;" class="mb-3">@(isNotFound ? "🔍" : "⚠️")</div>

                    @if (isNotFound)
                    {
                        <h1 class="mb-3">Page Not Found</h1>
                        <p class="text-muted-wood mb-4">
                            The link may be outdated, or the address may contain a mistake.
                        </p>
                    }
                    else
                    {
                        <h1 class="mb-3">Something Went Wrong</h1>
                        <p class="text-muted-wood mb-4">
                            Something went wrong on our server. Please try again in a moment.
                            If it keeps happening, please let us know.
                        </p>
                    }

                    @if (code is not null)
                    {
                        <p class="small text-muted-wood">Reference code: @code</p>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-wood">Go to Home</a>
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-wood">Browse Products</a>
                        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-wood">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
