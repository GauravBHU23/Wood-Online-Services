@using Microsoft.Extensions.Options
@using WoodOnlineService.Models
@inject IOptions<SiteSettings> Site
@{
    var site = Site.Value;
    ViewData["Title"] = "Thank You";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-7 mx-auto">
            <div class="panel">
                <div class="panel-body text-center py-5">
                    <div style="font-size:3.5rem;" class="mb-3">✅</div>
                    <h1 class="mb-3">Thank You!</h1>
                    <p class="text-muted-wood mb-4">
                        We have received your message. We will contact you
                        by phone or WhatsApp within 24 hours.
                    </p>
                    <p class="mb-4">
                        If you need to speak sooner, call us directly — <a href="tel:@site.Phone.Replace(" ", "")"><strong>@site.Phone</strong></a>
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-wood">Continue Shopping</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-wood">Go to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
