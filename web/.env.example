# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -----------------------------------------------------------------
# Public origin used to build absolute links in emails and the Cashfree return/webhook URLs.
# Must be a public HTTPS domain in production; Cashfree cannot reach localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cashfree Payment Gateway (Payments -> API Keys) -----------------------
# Mode: disabled | simulated | live  (see src/lib/payments/cashfree.ts)
CASHFREE_MODE=disabled
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2026-01-01

# --- Email (SMTP) -----------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ADMIN_EMAIL=

# --- Google Gemini (chatbot phrasing; optional) -----------------------------
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Visitor geolocation (optional; footer counter still works without it) --
GEO_ENABLED=true

# --- Cron auth (Services/PaymentReconciliationService.cs's safety net for missed webhooks) --
# A random secret; the scheduler must send it as "Authorization: Bearer <value>" when calling
# /api/cron/reconcile-payments. Generate with: openssl rand -hex 32
CRON_SECRET=
